@model BandsApp.Web.Models.Band[]

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Document</title>
	<link rel="stylesheet" 
		href="~/css/style.css" />
</head>
<body>
	<div class="home">
		<h2 class="text">Favorit-band</h2>
		<img class="main" src="/images/Band-Home2.png" />

		<ul class="flex fix">
			@foreach (var item in Model)
				{
					<a href="https://localhost:7057/bands/@item.Id">@item.Name</a>
				}
			</ul>
	</div>

</body>
</html>
